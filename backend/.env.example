# SHOES backend — copy to backend/.env and fill in. NEVER commit the real .env.
# Existing (already configured by the owner)
PORT=5000
FRONTEND_URL=http://localhost:5173
# Extra allowed browser origins, comma-separated (https://shoes-red-alpha.vercel.app + localhost are built in)
CORS_ORIGINS=
DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM=
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Clerk (leave empty to keep Firebase-only auth)
CLERK_SECRET_KEY=
# Mirror of the publishable key (optional; used only for ops/scripts — never sent to browsers)
CLERK_PUBLISHABLE_KEY=
# Webhook signing secret from Clerk Dashboard → Webhooks (whsec_…)
CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated frontend origins allowed to present Clerk tokens, e.g. http://localhost:5173,https://shoes-red-alpha.vercel.app
CLERK_AUTHORIZED_PARTIES=

# Optional: Stripe Checkout (TEST MODE). Both are required to enable Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live keys (sk_live_) are refused unless this is exactly "true". Do not set without approval.
STRIPE_LIVE_MODE_APPROVED=

# Optional operations
AUTO_MIGRATE=false
LOG_LEVEL=info
PG_POOL_MAX=10

# Smart commerce: server-side credentials only, never VITE_*.
REDIS_URL=redis://127.0.0.1:56379
MEILI_HOST=http://127.0.0.1:57700
MEILI_API_KEY=
MEILI_INDEX=shoes_products
# Tests refuse remote hosts and databases without the _test suffix.
TEST_DATABASE_URL=postgres://shoes:local-shoes-only@127.0.0.1:55433/shoes_test
# npm run worker requires a persistent Node runtime. Do not run it on Vercel.

# Order tracking WebSocket (Socket.IO) runs on the same PORT as the API when not on Vercel.
# Optional carrier integration — leave empty for manual tracking numbers from admin only.
SHIPPING_API_URL=
SHIPPING_API_KEY=
SHIPPING_PROVIDER_NAME=
