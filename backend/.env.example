# SHOES backend — copy to backend/.env. Never commit the real file.
PORT=5000
DATABASE_URL=
# Firebase project ID (required to verify sign-ins), e.g. shoes-store-5606a
FIREBASE_PROJECT_ID=
# Optional: path to a service-account JSON (NOT needed for verifying ID tokens)
GOOGLE_APPLICATION_CREDENTIALS=
# Extra allowed browser origins, comma-separated (https://shoes-red-alpha.vercel.app and localhost are built in)
CORS_ORIGINS=
FRONTEND_URL=
RESEND_API_KEY=
EMAIL_FROM=
