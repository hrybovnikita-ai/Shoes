# SHOES frontend — copy to frontend/.env.local. NEVER commit the real file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local dev: use /api (Vite proxies to http://localhost:5000). Production: full URL.
VITE_API_URL=/api
# Optional: Socket.IO origin (defaults to VITE_API_URL without /api)
VITE_SOCKET_URL=

# Clerk (publishable only — never put sk_ secrets in the frontend)
VITE_CLERK_PUBLISHABLE_KEY=
# Local testing only: Firebase Auth emulator, e.g. 127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR_HOST=
