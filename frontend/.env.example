# SHOES frontend — copy to frontend/.env.local. NEVER commit the real file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_URL=

# Optional: enables the Clerk sign-in option (publishable key only — never a secret key here)
VITE_CLERK_PUBLISHABLE_KEY=
# Local testing only: Firebase Auth emulator, e.g. 127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR_HOST=
