# SHOES frontend — copy to frontend/.env.local. Never commit the real file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Full backend API base incl. /api, e.g. https://shoes-backend-liard.vercel.app/api (empty = /api via Vite proxy)
VITE_API_URL=
# Local testing only: Firebase Auth emulator, e.g. 127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR_HOST=
